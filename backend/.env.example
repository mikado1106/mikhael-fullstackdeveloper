# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://indokerja:indokerja@localhost:5432/indokerja?schema=public"

# Secret used to sign JWT access tokens. Use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-string"
# Access token lifetime in seconds (86400 = 1 day)
JWT_EXPIRES_IN_SECONDS=86400

PORT=3000

# Comma separated
CORS_ORIGIN="http://localhost:5173"
