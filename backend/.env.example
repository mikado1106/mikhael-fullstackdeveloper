# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://lokerkita:lokerkita@localhost:5432/lokerkita?schema=public"

# Secret used to sign JWT access tokens. Use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-string"
# Access token lifetime in seconds (86400 = 1 day)
JWT_EXPIRES_IN_SECONDS=86400

PORT=3000

# Comma separated
CORS_ORIGIN="http://localhost:5173"

# Optional Resend API key. Empty uses the log driver; whitespace is trimmed.
# Production log driver logs only a generic message without email content.
RESEND_API_KEY=""

# Optional sender address; defaults to noreply@lokerkita.id and must contain @.
# Use a verified sender domain when sending through Resend.
MAIL_FROM="noreply@lokerkita.id"

# Optional frontend base URL for application links; empty omits the link.
# Must start with http:// or https://; no credentials, query string, or fragment.
APP_URL=""
