// Run `npx prisma migrate dev` after changing this file.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  JOB_SEEKER
  COMPANY
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum ApplicationStatus {
  APPLIED
  REVIEWING
  SHORTLISTED
  REJECTED
  ACCEPTED
}

enum CvUploadStatus {
  PENDING
  VERIFYING
  FINALIZED
  FAILED
  EXPIRED
  SUPERSEDED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company       Company?
  applications  Application[]
  statusChanges ApplicationStatusHistory[] @relation("StatusChangedBy")
  savedJobs     SavedJob[]
  cvDocument    CvDocument?

  @@map("users")
}

model Company {
  id          String   @id @default(uuid())
  userId      String   @unique
  name        String
  location    String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs Job[]

  @@map("companies")
}

/// Salary is stored in IDR per month. Null bounds represent open intervals;
/// two null bounds mean salary is undisclosed.
model Job {
  id          String   @id @default(uuid())
  companyId   String
  title       String
  description String
  location    String
  salaryMin   Int?
  salaryMax   Int?
  jobType     JobType
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications Application[]
  savedJobs    SavedJob[]

  @@index([companyId])
  // Retain the existing index until deployment query-plan audit permits removal.
  @@index([isActive, createdAt])
  @@index([isActive, createdAt, id])
  @@map("jobs")
}

/// The unique constraint guarantees one application per seeker per job,
/// even under concurrent requests.
model Application {
  id          String            @id @default(uuid())
  jobId       String
  applicantId String
  status      ApplicationStatus @default(APPLIED)
  coverLetter String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  job       Job                        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicant User                       @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  history   ApplicationStatusHistory[]

  @@unique([jobId, applicantId])
  @@index([applicantId])
  @@map("applications")
}

/// `fromStatus` is null for the initial APPLIED entry.
model ApplicationStatusHistory {
  id            String             @id @default(uuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  changedById   String
  note          String?
  createdAt     DateTime           @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy   User        @relation("StatusChangedBy", fields: [changedById], references: [id])

  @@index([applicationId, createdAt, id])
  @@map("application_status_histories")
}

model SavedJob {
  id        String   @id @default(uuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, createdAt, id])
  @@index([jobId])
  @@map("saved_jobs")
}

model CvDocument {
  id               String @id @default(uuid())
  userId           String @unique
  latestIssued     BigInt @default(0)
  activeGeneration BigInt @default(0)

  activeObjectPath String?   @unique
  activeFileName   String?
  activeSizeBytes  Int?
  activeMimeType   String?
  activatedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts CvUploadAttempt[]

  @@map("cv_documents")
}

model CvUploadAttempt {
  id         String         @id @default(uuid())
  documentId String
  generation BigInt
  status     CvUploadStatus @default(PENDING)

  temporaryObjectPath String @unique
  finalObjectPath     String @unique
  fileName            String
  declaredSizeBytes   Int
  declaredMimeType    String

  expiresAt             DateTime
  uploadCapabilityUntil DateTime
  leaseToken            String?
  leaseUntil            DateTime?
  finalizedAt           DateTime?
  failureCode           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  document CvDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, generation])
  @@index([documentId, status, expiresAt])
  @@index([status, expiresAt])
  @@index([status, leaseUntil])
  @@map("cv_upload_attempts")
}

model StorageCleanupTask {
  id            String    @id @default(uuid())
  objectPath    String    @unique
  reason        String
  unneededAt    DateTime
  notBefore     DateTime
  nextRunAt     DateTime
  attempts      Int       @default(0)
  leaseToken    String?
  leaseUntil    DateTime?
  completedAt   DateTime?
  lastErrorCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([completedAt, nextRunAt])
  @@map("storage_cleanup_tasks")
}
